---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<div
  id="lab-chat-root"
  class="lab-chat-root"
  data-review-url={`${base}admin/documents`}
  hidden
>
  <section id="lab-chat-panel" class="lab-chat-panel" hidden aria-label="实验室消息中心">
    <header class="lab-chat-header">
      <div class="lab-chat-header-copy">
        <span>团队协作</span>
        <strong>消息中心</strong>
      </div>
      <button id="lab-chat-close" class="lab-chat-icon-button" type="button" aria-label="关闭消息中心">×</button>
    </header>

    <div class="lab-chat-tabs" role="tablist" aria-label="消息类型">
      <button id="lab-chat-tab-public" type="button" class="is-active">
        <span>公屏</span>
        <strong id="lab-chat-public-badge" class="lab-chat-tab-badge" hidden>0</strong>
      </button>
      <button id="lab-chat-tab-direct" type="button">
        <span>私聊</span>
        <strong id="lab-chat-direct-badge" class="lab-chat-tab-badge" hidden>0</strong>
      </button>
    </div>

    <div id="lab-chat-direct-tools" class="lab-chat-direct-tools" hidden>
      <div class="lab-chat-inbox-row">
        <div class="lab-chat-inbox-copy">
          <span id="lab-chat-queue-label">待回复</span>
          <strong id="lab-chat-current-peer">暂无待回复消息</strong>
          <small id="lab-chat-queue-progress">可主动发起私聊</small>
        </div>
        <button id="lab-chat-next-peer" class="lab-chat-next-button" type="button" hidden>
          下一个 →
        </button>
      </div>

      <div class="lab-chat-new-direct">
        <label for="lab-chat-recipient">发起私聊</label>
        <select id="lab-chat-recipient">
          <option value="">选择成员</option>
        </select>
      </div>
    </div>

    <div id="lab-chat-note" class="lab-chat-note">所有成员可见 · 消息保留 7 天</div>

    <div id="lab-chat-state" class="lab-chat-state">打开消息中心开始交流</div>
    <div id="lab-chat-messages" class="lab-chat-messages" hidden></div>

    <form id="lab-chat-form" class="lab-chat-form">
      <textarea
        id="lab-chat-input"
        maxlength="1000"
        rows="2"
        placeholder="发送到公屏…"
        aria-label="消息内容"
      ></textarea>
      <button id="lab-chat-send" type="submit">发送</button>
    </form>
  </section>

  <button id="lab-chat-launcher" class="lab-chat-launcher" type="button" aria-label="打开实验室消息中心">
    <span class="lab-chat-launcher-icon">讯</span>
    <span class="lab-chat-launcher-copy">
      <strong>消息中心</strong>
      <small id="lab-chat-launcher-status">团队消息与私聊</small>
    </span>
    <strong id="lab-chat-unread" class="lab-chat-unread" hidden>0</strong>
  </button>

  <div id="lab-review-alert" class="lab-review-alert" hidden>
    <a id="lab-review-open" href={`${base}admin/documents`}>
      <span class="lab-review-dot"></span>
      <span>待审核文档</span>
      <strong id="lab-review-count">0</strong>
    </a>
    <button id="lab-review-dismiss" type="button" aria-label="暂时关闭审核提醒">×</button>
  </div>
</div>

<script>
  import {
    clearSession,
    getCurrentUser,
    getSessionToken,
  } from "../lib/auth";

  const AUTH_WORKER =
    "https://sylu-icdl-auth.hugozhao6.workers.dev";

  type ChatContact = {
    githubId: number;
    login: string;
    name: string;
    role: string;
    unread: number;
  };

  type ChatMessage = {
    id: number;
    senderId: number;
    senderLogin: string;
    senderName: string;
    recipientId?: number;
    recipientLogin?: string;
    recipientName?: string;
    content: string;
    createdAt: string;
    deliveredAt?: string | null;
    expiresAt?: string | null;
    mine: boolean;
  };

  const root = document.querySelector<HTMLElement>("#lab-chat-root");
  const panel = document.querySelector<HTMLElement>("#lab-chat-panel");

  const compactForEditor =
    window.location.pathname.includes("/documents/edit");

  if (compactForEditor) {
    root?.classList.add("is-editor-compact");
  }
  const launcher = document.querySelector<HTMLButtonElement>("#lab-chat-launcher");
  const launcherStatus = document.querySelector<HTMLElement>("#lab-chat-launcher-status");
  const closeButton = document.querySelector<HTMLButtonElement>("#lab-chat-close");
  const unreadBadge = document.querySelector<HTMLElement>("#lab-chat-unread");

  const publicTab = document.querySelector<HTMLButtonElement>("#lab-chat-tab-public");
  const directTab = document.querySelector<HTMLButtonElement>("#lab-chat-tab-direct");
  const publicBadge = document.querySelector<HTMLElement>("#lab-chat-public-badge");
  const directBadge = document.querySelector<HTMLElement>("#lab-chat-direct-badge");

  const directTools = document.querySelector<HTMLElement>("#lab-chat-direct-tools");
  const recipientSelect = document.querySelector<HTMLSelectElement>("#lab-chat-recipient");
  const queueLabel = document.querySelector<HTMLElement>("#lab-chat-queue-label");
  const currentPeer = document.querySelector<HTMLElement>("#lab-chat-current-peer");
  const queueProgress = document.querySelector<HTMLElement>("#lab-chat-queue-progress");
  const nextPeerButton = document.querySelector<HTMLButtonElement>("#lab-chat-next-peer");

  const note = document.querySelector<HTMLElement>("#lab-chat-note");
  const state = document.querySelector<HTMLElement>("#lab-chat-state");
  const messagesBox = document.querySelector<HTMLElement>("#lab-chat-messages");

  const form = document.querySelector<HTMLFormElement>("#lab-chat-form");
  const input = document.querySelector<HTMLTextAreaElement>("#lab-chat-input");
  const sendButton = document.querySelector<HTMLButtonElement>("#lab-chat-send");

  const reviewAlert = document.querySelector<HTMLElement>("#lab-review-alert");
  const reviewCount = document.querySelector<HTMLElement>("#lab-review-count");
  const reviewDismiss = document.querySelector<HTMLButtonElement>("#lab-review-dismiss");

  let currentUser: Awaited<ReturnType<typeof getCurrentUser>> = null;
  let mode: "public" | "direct" = "public";
  let contacts: ChatContact[] = [];
  let panelOpen = false;
  let sending = false;
  let reviewDismissed = false;
  let viewPollTimer: number | null = null;
  let statusPollTimer: number | null = null;

  let activePeerId = 0;
  let pendingQueue: number[] = [];
  let queueIndex = 0;
  const repliedPeers = new Set<number>();

  function capped(value: number) {
    return value > 99 ? "99+" : String(value);
  }

  function setBadge(target: HTMLElement | null, value: number) {
    if (!target) return;
    target.textContent = capped(value);
    target.hidden = value <= 0;
  }

  function setState(message: string) {
    if (state) {
      state.textContent = message;
      state.hidden = false;
    }
    if (messagesBox) messagesBox.hidden = true;
  }

  function showMessages() {
    if (state) state.hidden = true;
    if (messagesBox) messagesBox.hidden = false;
  }

  function formatTime(value: string) {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return "";
    return date.toLocaleString("zh-CN", {
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
  }

  async function api(path: string, options: RequestInit = {}) {
    const token = getSessionToken();
    if (!token) throw new Error("登录状态已失效。");

    const response = await fetch(`${AUTH_WORKER}${path}`, {
      ...options,
      headers: {
        Authorization: `Bearer ${token}`,
        ...(options.body ? { "Content-Type": "application/json" } : {}),
        ...(options.headers || {}),
      },
    });

    if (response.status === 401) {
      clearSession();
      if (root) root.hidden = true;
      throw new Error("登录状态已失效。");
    }

    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.message || "请求失败。");
    }
    return data;
  }

  async function refreshStatus() {
    if (!currentUser?.access?.authorized) return;

    try {
      const data = await api("/api/chat/status");
      const unreadDirect = Number(data.unreadDirect || 0);
      const unreadPublic = Number(data.unreadPublic || 0);
      const unreadTotal = Number(
        data.unreadTotal ?? (unreadDirect + unreadPublic)
      );

      setBadge(unreadBadge, unreadTotal);
      setBadge(publicBadge, unreadPublic);
      setBadge(directBadge, unreadDirect);

      if (launcherStatus) {
        if (unreadTotal > 0) {
          launcherStatus.textContent =
            unreadPublic > 0 && unreadDirect > 0
              ? `公屏 ${unreadPublic} · 私聊 ${unreadDirect}`
              : unreadDirect > 0
                ? `${unreadDirect} 条私聊未读`
                : `${unreadPublic} 条公屏新消息`;
        } else {
          launcherStatus.textContent = "团队消息与私聊";
        }
      }

      const pending = Number(data.pendingReviews || 0);
      const showReview =
        Boolean(currentUser.access.isAdmin) &&
        pending > 0 &&
        !reviewDismissed;

      if (reviewCount) reviewCount.textContent = capped(pending);
      if (reviewAlert) reviewAlert.hidden = !showReview;
    } catch (error) {
      console.error("Chat status error:", error);
    }
  }

  function contactById(id: number) {
    return contacts.find((item) => item.githubId === id) || null;
  }

  function renderContacts() {
    if (!recipientSelect) return;

    const selected = recipientSelect.value;
    recipientSelect.replaceChildren();

    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent =
      contacts.length > 0 ? "选择成员发起会话" : "暂无可联系成员";
    recipientSelect.append(placeholder);

    for (const contact of contacts) {
      const option = document.createElement("option");
      option.value = String(contact.githubId);
      option.textContent = contact.name;
      recipientSelect.append(option);
    }

    if (
      selected &&
      contacts.some((item) => String(item.githubId) === selected)
    ) {
      recipientSelect.value = selected;
    }
  }

  async function loadContacts() {
    const data = await api("/api/chat/contacts");
    contacts = Array.isArray(data.contacts) ? data.contacts : [];
    renderContacts();
  }

  function buildQueueFromUnread(reset = false) {
    const unreadIds = contacts
      .filter((item) => item.unread > 0)
      .map((item) => item.githubId);

    if (reset) {
      pendingQueue = unreadIds;
      queueIndex = 0;
      repliedPeers.clear();
      return;
    }

    for (const id of unreadIds) {
      if (!pendingQueue.includes(id) && !repliedPeers.has(id)) {
        pendingQueue.push(id);
      }
    }
  }

  function updateDirectToolbar() {
    if (!queueLabel || !currentPeer || !queueProgress || !nextPeerButton) return;

    const active = contactById(activePeerId);
    const activeQueueIndex = pendingQueue.indexOf(activePeerId);

    if (pendingQueue.length === 0) {
      queueLabel.textContent = "私聊";
      currentPeer.textContent = active ? `正在与 ${active.name} 交流` : "暂无待回复消息";
      queueProgress.textContent = active ? "可继续交流或选择其他成员" : "可从下方选择成员发起私聊";
      nextPeerButton.hidden = true;
      return;
    }

    if (activeQueueIndex >= 0) {
      queueIndex = activeQueueIndex;
      queueLabel.textContent = "待回复";
      currentPeer.textContent = active?.name || "成员";
      queueProgress.textContent = `${activeQueueIndex + 1} / ${pendingQueue.length}`;
      nextPeerButton.hidden = false;
      nextPeerButton.textContent =
        activeQueueIndex === pendingQueue.length - 1 ? "完成" : "下一个 →";
      nextPeerButton.disabled = !repliedPeers.has(activePeerId);
      return;
    }

    queueLabel.textContent = "待回复";
    currentPeer.textContent = `还有 ${pendingQueue.length} 位成员等待回复`;
    queueProgress.textContent = "当前正在主动私聊";
    nextPeerButton.hidden = false;
    nextPeerButton.textContent = "继续待回复";
    nextPeerButton.disabled = false;
  }

  function renderMessages(items: ChatMessage[], currentMode: "public" | "direct") {
    if (!messagesBox) return;

    messagesBox.replaceChildren();

    if (items.length === 0) {
      setState(
        currentMode === "public"
          ? "还没有公屏消息"
          : "这个会话还没有消息"
      );
      return;
    }

    for (const item of items) {
      const row = document.createElement("div");
      row.className =
        `lab-chat-message ${item.mine ? "is-mine" : "is-other"}`;

      const meta = document.createElement("div");
      meta.className = "lab-chat-message-meta";

      const sender = document.createElement("strong");
      sender.textContent = item.mine ? "我" : item.senderName;

      const time = document.createElement("span");
      time.textContent = formatTime(item.createdAt);

      meta.append(sender, time);

      const bubble = document.createElement("div");
      bubble.className = "lab-chat-message-bubble";
      bubble.textContent = item.content;

      row.append(meta, bubble);
      messagesBox.append(row);
    }

    showMessages();
    messagesBox.scrollTop = messagesBox.scrollHeight;
  }

  async function loadPublic(markRead = true) {
    setState("正在加载消息…");
    try {
      const data = await api(
        `/api/chat/public${markRead ? "?receive=1" : ""}`
      );
      renderMessages(
        Array.isArray(data.messages) ? data.messages : [],
        "public"
      );
      if (markRead) await refreshStatus();
    } catch (error) {
      setState(error instanceof Error ? error.message : "暂时无法加载消息。");
    }
  }

  async function loadDirect(peerId = activePeerId, markReceive = true) {
    if (!peerId) {
      setState("暂无待回复消息，可选择成员发起私聊。");
      updateDirectToolbar();
      return;
    }

    activePeerId = peerId;
    const peer = contactById(peerId);
    if (recipientSelect) recipientSelect.value = "";

    setState("正在加载会话…");
    updateDirectToolbar();

    try {
      const data = await api(
        `/api/chat/direct?peer=${encodeURIComponent(peerId)}${markReceive ? "&receive=1" : ""}`
      );

      renderMessages(
        Array.isArray(data.messages) ? data.messages : [],
        "direct"
      );

      if (peer && currentPeer) currentPeer.textContent = peer.name;

      await loadContacts();
      buildQueueFromUnread(false);
      updateDirectToolbar();
      await refreshStatus();
    } catch (error) {
      setState(error instanceof Error ? error.message : "暂时无法加载会话。");
    }
  }

  async function initializeDirectInbox() {
    setState("正在整理待回复消息…");

    try {
      await loadContacts();
      buildQueueFromUnread(true);

      if (pendingQueue.length > 0) {
        activePeerId = pendingQueue[0];
        await loadDirect(activePeerId, true);
      } else {
        activePeerId = 0;
        updateDirectToolbar();
        setState("暂无待回复消息，可选择成员发起私聊。");
      }
    } catch (error) {
      setState(error instanceof Error ? error.message : "暂时无法加载私聊。");
    }
  }

  async function refreshDirectView() {
    try {
      await loadContacts();
      const beforeEmpty = pendingQueue.length === 0;
      buildQueueFromUnread(false);

      if (!activePeerId && pendingQueue.length > 0) {
        activePeerId = pendingQueue[0];
        await loadDirect(activePeerId, true);
        return;
      }

      if (beforeEmpty && pendingQueue.length > 0 && activePeerId) {
        updateDirectToolbar();
      }

      if (activePeerId) {
        await loadDirect(activePeerId, true);
      } else {
        updateDirectToolbar();
      }
    } catch (error) {
      console.error("Direct chat refresh error:", error);
    }
  }

  async function refreshCurrentView() {
    if (!panelOpen) return;
    if (mode === "public") {
      await loadPublic(true);
    } else {
      await refreshDirectView();
    }
  }

  async function switchMode(next: "public" | "direct") {
    mode = next;

    publicTab?.classList.toggle("is-active", next === "public");
    directTab?.classList.toggle("is-active", next === "direct");

    if (directTools) directTools.hidden = next !== "direct";

    if (note) {
      note.textContent =
        next === "public"
          ? "所有成员可见 · 消息保留 7 天"
          : "打开收到的会话后，消息保留 24 小时";
    }

    if (input) {
      input.placeholder =
        next === "public"
          ? "发送到公屏…"
          : activePeerId
            ? "回复消息…"
            : "选择成员后发送私聊…";
    }

    if (next === "direct") {
      await initializeDirectInbox();
    } else {
      await loadPublic(true);
    }
  }

  async function openPanel() {
    panelOpen = true;
    root?.classList.add("is-panel-open");
    if (panel) panel.hidden = false;
    launcher?.classList.add("is-open");

    await switchMode(mode);

    if (viewPollTimer !== null) window.clearInterval(viewPollTimer);
    viewPollTimer = window.setInterval(() => {
      refreshCurrentView();
    }, 12000);
  }

  function closePanel() {
    panelOpen = false;
    root?.classList.remove("is-panel-open");
    if (panel) panel.hidden = true;
    launcher?.classList.remove("is-open");

    if (viewPollTimer !== null) {
      window.clearInterval(viewPollTimer);
      viewPollTimer = null;
    }
  }

  async function goNextPeer() {
    if (pendingQueue.length === 0) return;

    const activeQueueIndex = pendingQueue.indexOf(activePeerId);

    if (activeQueueIndex < 0) {
      queueIndex = Math.min(queueIndex, pendingQueue.length - 1);
      activePeerId = pendingQueue[queueIndex];
      await loadDirect(activePeerId, true);
      return;
    }

    if (!repliedPeers.has(activePeerId)) return;

    if (activeQueueIndex < pendingQueue.length - 1) {
      queueIndex = activeQueueIndex + 1;
      activePeerId = pendingQueue[queueIndex];
      await loadDirect(activePeerId, true);
      return;
    }

    pendingQueue = [];
    queueIndex = 0;
    updateDirectToolbar();
    if (queueProgress) queueProgress.textContent = "本轮待回复消息已处理完成";
  }

  launcher?.addEventListener("click", () => {
    if (panelOpen) closePanel();
    else openPanel();
  });

  closeButton?.addEventListener("click", closePanel);
  publicTab?.addEventListener("click", () => switchMode("public"));
  directTab?.addEventListener("click", () => switchMode("direct"));
  nextPeerButton?.addEventListener("click", goNextPeer);

  recipientSelect?.addEventListener("change", async () => {
    const peerId = Number(recipientSelect.value || 0);
    if (!peerId || mode !== "direct") return;

    activePeerId = peerId;
    if (input) input.placeholder = "发送私聊消息…";
    await loadDirect(peerId, true);
  });

  reviewDismiss?.addEventListener("click", () => {
    reviewDismissed = true;
    if (reviewAlert) reviewAlert.hidden = true;
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!input || !sendButton || sending) return;

    const content = input.value.trim();
    if (!content) return;

    if (mode === "direct" && !activePeerId) {
      setState("请选择接收成员，或进入待回复会话。");
      return;
    }

    sending = true;
    sendButton.disabled = true;
    sendButton.textContent = "发送中…";

    try {
      if (mode === "public") {
        await api("/api/chat/public", {
          method: "POST",
          body: JSON.stringify({ content }),
        });
      } else {
        await api("/api/chat/direct", {
          method: "POST",
          body: JSON.stringify({
            recipientId: activePeerId,
            content,
          }),
        });

        if (pendingQueue.includes(activePeerId)) {
          repliedPeers.add(activePeerId);
        }
      }

      input.value = "";
      await refreshCurrentView();
      updateDirectToolbar();
      await refreshStatus();
    } catch (error) {
      setState(error instanceof Error ? error.message : "发送失败，请稍后重试。");
    } finally {
      sending = false;
      sendButton.disabled = false;
      sendButton.textContent = "发送";
      input.focus();
    }
  });

  input?.addEventListener("keydown", (event) => {
    if (
      event.key === "Enter" &&
      !event.shiftKey &&
      !event.isComposing
    ) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  async function initializeChat() {
    try {
      currentUser = await getCurrentUser();

      if (!currentUser?.access?.authorized) return;

      if (root) root.hidden = false;

      await refreshStatus();

      statusPollTimer = window.setInterval(() => {
        refreshStatus();
      }, 15000);
    } catch (error) {
      console.error("Chat initialization error:", error);
    }
  }

  window.addEventListener("pagehide", () => {
    if (viewPollTimer !== null) window.clearInterval(viewPollTimer);
    if (statusPollTimer !== null) window.clearInterval(statusPollTimer);
  });

  initializeChat();
</script>

<style is:global>
  .lab-chat-root[hidden],
  .lab-chat-panel[hidden],
  .lab-review-alert[hidden],
  .lab-chat-state[hidden],
  .lab-chat-messages[hidden],
  .lab-chat-direct-tools[hidden],
  .lab-chat-unread[hidden],
  .lab-chat-tab-badge[hidden],
  .lab-chat-next-button[hidden] {
    display: none !important;
  }

  .lab-chat-root {
    position: fixed;
    left: 22px;
    bottom: 22px;
    z-index: 1200;
    display: flex;
    width: min(460px, calc(100vw - 44px));
    flex-direction: column;
    align-items: flex-start;
    gap: 11px;
    pointer-events: none;
  }

  .lab-chat-root > * { pointer-events: auto; }

  .lab-chat-panel {
    display: flex;
    width: 100%;
    height: min(620px, calc(100vh - 130px));
    overflow: hidden;
    flex-direction: column;
    border: 1px solid #dfe5ee;
    border-radius: 20px;
    background: rgba(255,255,255,.99);
    box-shadow: 0 28px 82px rgba(26,39,66,.2);
    backdrop-filter: blur(18px);
    animation: lab-chat-enter 180ms cubic-bezier(.22,1,.36,1) both;
  }

  @keyframes lab-chat-enter {
    from { opacity: 0; transform: translateY(10px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .lab-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 18px 14px;
    border-bottom: 1px solid #edf0f4;
  }

  .lab-chat-header-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lab-chat-header-copy span {
    color: #7b8799;
    font-size: 10px;
    font-weight: 850;
  }

  .lab-chat-header-copy strong {
    color: #172033;
    font-size: 18px;
  }

  .lab-chat-icon-button {
    display: grid;
    width: 34px;
    height: 34px;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: #f3f6fa;
    color: #657187;
    cursor: pointer;
    font-size: 21px;
  }

  .lab-chat-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 11px 14px 0;
    gap: 7px;
  }

  .lab-chat-tabs button {
