---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="登录 | SYLU-ICDL">
  <main id="login-app" class="container" data-base={base}>
    <div class="auth-box">
      <div id="login-loading" class="login-state"><h1>正在检查登录状态</h1><p>请稍候。</p></div>
      <div id="login-panel" class="login-state" hidden>
        <h1>登录科研协作平台</h1>
        <p>使用 GitHub 账号登录。首次使用时，根据邀请信息完成成员验证即可。</p>
        <button id="github-login-button" type="button" class="github-button">使用 GitHub 登录</button>
      </div>
      <div id="login-error" class="login-state" hidden><h1>暂时无法登录</h1><p>请检查网络后重新尝试。</p><button id="retry-button" type="button" class="secondary-action-button">重新检查</button></div>
    </div>
  </main>
  <script>
    import { buildGitHubLoginUrl, consumeSessionFromHash, getCurrentUser, getSafeNextUrl } from "../lib/auth";
    const app=document.querySelector<HTMLElement>("#login-app"); const base=app?.dataset.base||"/";
    const loading=document.querySelector<HTMLElement>("#login-loading"); const panel=document.querySelector<HTMLElement>("#login-panel"); const error=document.querySelector<HTMLElement>("#login-error");
    const loginButton=document.querySelector<HTMLButtonElement>("#github-login-button"); const retryButton=document.querySelector<HTMLButtonElement>("#retry-button");
    const params=new URLSearchParams(window.location.search); const nextUrl=getSafeNextUrl(params.get("next"),`${base}workspace`);
    function show(target:HTMLElement|null){for(const element of [loading,panel,error]) if(element) element.hidden=element!==target;}
    async function initialize(){show(loading);consumeSessionFromHash();try{const me=await getCurrentUser();if(me){window.location.replace(me.access.authorized?nextUrl:`${base}verify?next=${encodeURIComponent(nextUrl)}`);return;}show(panel);}catch(e){console.error(e);show(error);}}
    loginButton?.addEventListener("click",()=>{window.location.href=buildGitHubLoginUrl(window.location.href);}); retryButton?.addEventListener("click",initialize); initialize();
  </script>
</BaseLayout>
