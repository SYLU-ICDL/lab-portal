---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="共享文档 | SYLU-ICDL"
  protectedPage={true}
>
  <main class="container page documents-page">
    <section class="documents-heading">
      <div>
        <div class="protected-badge">团队资料</div>
        <h1 class="page-title">共享文档</h1>
        <p class="page-description">
          分类整理实验室共享资料，支持在线阅读、编辑与维护。
        </p>
      </div>

      <div class="heading-actions">
        <button id="new-category-button" type="button" class="secondary-action">
          <span aria-hidden="true">＋</span> 新建分类
        </button>
        <button id="refresh-documents" type="button" class="refresh-button">
          刷新
        </button>
      </div>
    </section>

    <section class="document-library">
      <div class="library-toolbar">
        <div class="library-count">
          <strong id="documents-count">—</strong>
          <span id="documents-count-label">个文档分类</span>
        </div>
        <div id="library-hint" class="library-hint">
          选择分类查看文档
        </div>
      </div>

      <div id="documents-loading" class="documents-state">
        <div class="loading-ring" aria-hidden="true"></div>
        <p>正在加载共享文档…</p>
      </div>

      <div id="documents-error" class="documents-state error-state" hidden>
        <div class="state-icon">!</div>
        <h2>无法读取共享文档</h2>
        <p id="documents-error-message">请稍后重新尝试。</p>
      </div>

      <section id="root-panel" class="root-panel" hidden>
        <div id="category-grid" class="category-grid"></div>
        <div id="root-empty" class="documents-state" hidden>
          <div class="state-icon">📁</div>
          <h2>暂无分类</h2>
          <p>新建一个分类开始整理资料。</p>
          <button id="root-empty-create" type="button" class="primary-action">
            新建第一个分类
          </button>
        </div>
      </section>

      <section id="category-panel" class="category-panel" hidden>
        <div class="category-heading-row">
          <div class="category-heading-main">
            <button id="back-to-categories" type="button" class="breadcrumb-back">
              ← 返回全部分类
            </button>
            <div class="category-kicker">共享文档</div>
            <h2 id="current-category-title">分类名称</h2>
            <p id="current-category-description">分类中的文档</p>
          </div>
          <div class="category-actions">
            <button id="new-document-button" type="button" class="primary-action">
              ＋ 新建文档
            </button>
            <button id="delete-category-button" type="button" class="danger-outline-action" hidden>
              删除分类
            </button>
          </div>
        </div>

        <div class="category-list-toolbar">
          <span><strong id="category-document-count">0</strong> 篇 Markdown 文档</span>
          <span>支持阅读、编辑与删除</span>
        </div>

        <div id="category-empty" class="documents-state" hidden>
          <div class="state-icon">MD</div>
          <h2>暂无文档</h2>
          <p>新建一篇文档开始记录内容。</p>
        </div>

        <div id="category-documents-list" class="documents-list" hidden></div>
      </section>
    </section>
  </main>

  <dialog id="category-dialog" class="management-dialog">
    <form id="category-form" class="dialog-form">
      <div class="dialog-kicker">文档分类</div>
      <h2>新建文档分类</h2>
      <p class="dialog-description">
        输入名称即可创建新的资料分类。
      </p>
      <label for="category-name-input">分类名称</label>
      <input
        id="category-name-input"
        name="name"
        type="text"
        maxlength="80"
        placeholder="例如：论文规范、实验管理、开发规范"
        required
      />
      <div id="category-dialog-error" class="dialog-error" hidden></div>
      <div class="dialog-actions">
        <button type="button" class="dialog-cancel" data-close-dialog="category-dialog">取消</button>
        <button id="create-category-submit" type="submit" class="primary-action">创建分类</button>
      </div>
    </form>
  </dialog>

  <dialog id="document-dialog" class="management-dialog document-dialog">
    <form id="document-form" class="dialog-form">
      <div class="dialog-kicker">共享文档</div>
      <h2>新建文档</h2>
      <p class="dialog-description">
        在 <strong id="new-document-target">当前分类</strong> 中创建新文档，创建后可继续在线编辑。
      </p>
      <label for="document-name-input">文档名称</label>
      <input
        id="document-name-input"
        name="name"
        type="text"
        maxlength="100"
        placeholder="例如：paper-guide"
        required
      />
      <label for="document-markdown-input">文档内容</label>
      <textarea
        id="document-markdown-input"
        name="markdown"
        rows="9"
        placeholder="# 文档标题\n\n在这里编写 Markdown 内容。"
      ></textarea>
      <label for="document-summary-input">新增说明（可选）</label>
      <input
        id="document-summary-input"
        name="summary"
        type="text"
        maxlength="120"
        placeholder="例如：新增实验记录模板"
      />
      <div id="document-dialog-error" class="dialog-error" hidden></div>
      <div class="dialog-actions">
        <button type="button" class="dialog-cancel" data-close-dialog="document-dialog">取消</button>
        <button id="create-document-submit" type="submit" class="primary-action">创建文档</button>
      </div>
    </form>
  </dialog>

  <dialog id="delete-document-dialog" class="management-dialog">
    <form id="delete-document-form" class="dialog-form">
      <div class="dialog-kicker">共享文档</div>
      <h2>删除文档</h2>
      <p class="dialog-description">
        确认删除 <strong id="delete-document-name">当前文档</strong>。删除后该文档将从共享文档中移除。
      </p>
      <label for="delete-document-summary">删除说明（可选）</label>
      <textarea
        id="delete-document-summary"
        rows="4"
        maxlength="120"
        placeholder="例如：内容已失效，由新版文档替代"
      ></textarea>
      <div id="delete-document-dialog-error" class="dialog-error" hidden></div>
      <div class="dialog-actions">
        <button type="button" class="dialog-cancel" data-close-dialog="delete-document-dialog">取消</button>
        <button id="delete-document-submit" type="submit" class="danger-confirm-action">确认删除</button>
      </div>
    </form>
  </dialog>

  <script>
    import {
      clearSession,
      getCurrentUser,
      getSessionToken,
    } from "../lib/auth";

    const AUTH_WORKER =
      "https://sylu-icdl-auth.hugozhao6.workers.dev";
    const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

    type DocumentItem = {
      name: string;
      fileName: string;
      path: string;
      sha: string;
      size: number;
      githubUrl?: string;
    };

    type CategoryItem = {
      name: string;
      path: string;
      type: string;
    };

    const loading = document.querySelector<HTMLElement>("#documents-loading");
    const errorBox = document.querySelector<HTMLElement>("#documents-error");
    const errorMessage = document.querySelector<HTMLElement>("#documents-error-message");
    const rootPanel = document.querySelector<HTMLElement>("#root-panel");
    const categoryPanel = document.querySelector<HTMLElement>("#category-panel");
    const categoryGrid = document.querySelector<HTMLElement>("#category-grid");
    const rootEmpty = document.querySelector<HTMLElement>("#root-empty");
    const categoryEmpty = document.querySelector<HTMLElement>("#category-empty");
    const documentList = document.querySelector<HTMLElement>("#category-documents-list");
    const count = document.querySelector<HTMLElement>("#documents-count");
    const countLabel = document.querySelector<HTMLElement>("#documents-count-label");
    const hint = document.querySelector<HTMLElement>("#library-hint");

    const refreshButton = document.querySelector<HTMLButtonElement>("#refresh-documents");
    const newCategoryButton = document.querySelector<HTMLButtonElement>("#new-category-button");
    const rootEmptyCreate = document.querySelector<HTMLButtonElement>("#root-empty-create");
    const backButton = document.querySelector<HTMLButtonElement>("#back-to-categories");
    const newDocumentButton = document.querySelector<HTMLButtonElement>("#new-document-button");
    const deleteCategoryButton = document.querySelector<HTMLButtonElement>("#delete-category-button");

    const currentCategoryTitle = document.querySelector<HTMLElement>("#current-category-title");
    const currentCategoryDescription = document.querySelector<HTMLElement>("#current-category-description");
    const categoryDocumentCount = document.querySelector<HTMLElement>("#category-document-count");

    const categoryDialog = document.querySelector<HTMLDialogElement>("#category-dialog");
    const categoryForm = document.querySelector<HTMLFormElement>("#category-form");
    const categoryNameInput = document.querySelector<HTMLInputElement>("#category-name-input");
    const categoryDialogError = document.querySelector<HTMLElement>("#category-dialog-error");
    const createCategorySubmit = document.querySelector<HTMLButtonElement>("#create-category-submit");

    const documentDialog = document.querySelector<HTMLDialogElement>("#document-dialog");
    const documentForm = document.querySelector<HTMLFormElement>("#document-form");
    const documentNameInput = document.querySelector<HTMLInputElement>("#document-name-input");
    const documentMarkdownInput = document.querySelector<HTMLTextAreaElement>("#document-markdown-input");
    const documentSummaryInput = document.querySelector<HTMLInputElement>("#document-summary-input");
    const documentDialogError = document.querySelector<HTMLElement>("#document-dialog-error");
    const createDocumentSubmit = document.querySelector<HTMLButtonElement>("#create-document-submit");
    const newDocumentTarget = document.querySelector<HTMLElement>("#new-document-target");

    const deleteDocumentDialog = document.querySelector<HTMLDialogElement>("#delete-document-dialog");
    const deleteDocumentForm = document.querySelector<HTMLFormElement>("#delete-document-form");
    const deleteDocumentName = document.querySelector<HTMLElement>("#delete-document-name");
    const deleteDocumentSummary = document.querySelector<HTMLTextAreaElement>("#delete-document-summary");
    const deleteDocumentDialogError = document.querySelector<HTMLElement>("#delete-document-dialog-error");
    const deleteDocumentSubmit = document.querySelector<HTMLButtonElement>("#delete-document-submit");

    const themes = ["blue", "green", "orange", "purple", "cyan", "rose", "indigo", "amber"];
    let currentCategory: string | null = null;
    let currentIsUncategorized = false;
    let busy = false;
    let canEditDocuments = false;
    let pendingDeleteItem: DocumentItem | null = null;

    function hashValue(value: string) {
      let hash = 0;
      for (let i = 0; i < value.length; i++) {
        hash = ((hash << 5) - hash) + value.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash);
    }

    function pickTheme(index: number, seed = "") {
      const offset = seed ? hashValue(seed) % themes.length : 0;
      return themes[(offset + index) % themes.length];
    }

    function showLoading() {
      for (const el of [loading, errorBox, rootPanel, categoryPanel]) {
        if (el) el.hidden = el !== loading;
      }
    }

    function showError(message: string) {
      if (errorMessage) errorMessage.textContent = message;
      for (const el of [loading, errorBox, rootPanel, categoryPanel]) {
        if (el) el.hidden = el !== errorBox;
      }
    }

    function showRoot() {
      for (const el of [loading, errorBox, rootPanel, categoryPanel]) {
        if (el) el.hidden = el !== rootPanel;
      }
    }

    function showCategory() {
      for (const el of [loading, errorBox, rootPanel, categoryPanel]) {
        if (el) el.hidden = el !== categoryPanel;
      }
    }

    async function apiRequest(path: string, init: RequestInit = {}) {
      const session = getSessionToken();
      if (!session) {
        window.location.reload();
        throw new Error("登录状态已失效，请重新登录。");
      }

      const headers = new Headers(init.headers);
      headers.set("Authorization", `Bearer ${session}`);
      if (init.body && !headers.has("Content-Type")) {
        headers.set("Content-Type", "application/json");
      }

      const response = await fetch(`${AUTH_WORKER}${path}`, {
        ...init,
        headers,
        cache: "no-store",
      });

      if (response.status === 401) {
        clearSession();
        window.location.reload();
        throw new Error("登录会话已过期，请重新登录。");
      }

      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.message || `请求失败（HTTP ${response.status}）。`);
      }
      return data;
    }

    function makePageUrl(params?: { category?: string; uncategorized?: boolean }) {
      const url = new URL(window.location.href);
      url.search = "";
      if (params?.category) url.searchParams.set("category", params.category);
      if (params?.uncategorized) url.searchParams.set("uncategorized", "1");
      return url;
    }

    function navigateToRoot() {
      currentCategory = null;
      currentIsUncategorized = false;
      const url = makePageUrl();
      window.history.pushState({}, "", url);
      loadFromLocation();
    }

    function navigateToCategory(category: string | null, uncategorized = false) {
      currentCategory = category;
      currentIsUncategorized = uncategorized;
      const url = makePageUrl(
        uncategorized ? { uncategorized: true } : category ? { category } : undefined
      );
      window.history.pushState({}, "", url);
      loadFromLocation();
    }

    function createCategoryCard(item: CategoryItem | { name: string; path: string; uncategorized: true; count: number }, index: number) {
      const name = item.name;
      const theme = pickTheme(index, "categories-root");
      const card = document.createElement("article");
      card.className = `category-card theme-${theme}`;

      const accent = document.createElement("div");
      accent.className = "category-accent";

      const body = document.createElement("div");
      body.className = "category-card-main";

      const badge = document.createElement("span");
      badge.className = "category-type-badge";
      badge.textContent = "uncategorized" in item ? "默认分类" : "文件夹分类";

      const title = document.createElement("h2");
      title.textContent = name;

      const description = document.createElement("p");
      description.textContent = "uncategorized" in item
        ? `${item.count} 篇文档 · 未归类资料`
        : "资料分类";

      body.append(badge, title, description);

      const enter = document.createElement("button");
      enter.type = "button";
      enter.className = "category-enter-button";
      enter.textContent = "进入分类　→";
      enter.addEventListener("click", () => {
        if ("uncategorized" in item) navigateToCategory(null, true);
        else navigateToCategory(item.name);
      });

      card.append(accent, body, enter);
      return card;
    }

    function createDocumentRow(item: DocumentItem, index: number) {
      const row = document.createElement("article");
      const theme = pickTheme(index, currentCategory || (currentIsUncategorized ? "uncategorized" : "documents"));
      row.className = `document-row theme-${theme}`;

      const accent = document.createElement("div");
      accent.className = "document-accent";

      const body = document.createElement("div");
      body.className = "document-main";

      const badge = document.createElement("span");
      badge.className = "file-type-badge";
      badge.textContent = "文档";

      const title = document.createElement("h3");
      title.className = "document-title";
      title.textContent = item.name;
      body.append(badge, title);

      const actions = document.createElement("div");
      actions.className = "document-actions";

      const readLink = document.createElement("a");
      readLink.className = "read-button";
      readLink.href = `${base}documents/view?path=${encodeURIComponent(item.path)}`;
      readLink.textContent = "阅读　→";

      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className = "delete-document-button";
      deleteButton.textContent = "删除";
      deleteButton.addEventListener("click", () => deleteDocument(item));

      actions.append(readLink);
      if (canEditDocuments) actions.append(deleteButton);
      row.append(accent, body, actions);
      return row;
    }

    async function loadRoot() {
      showLoading();
      try {
        const data = await apiRequest("/api/documents");
        const categories: CategoryItem[] = (Array.isArray(data.categories) ? data.categories : []).sort((a, b) => a.name.localeCompare(b.name, "zh-Hans-CN"));
        const groups: Array<CategoryItem | { name: string; path: string; uncategorized: true; count: number }> = [...categories];

        if (Number(data.uncategorizedCount) > 0) {
          groups.push({
            name: "未分类文档",
            path: "documents",
            uncategorized: true,
            count: Number(data.uncategorizedCount),
          });
        }

        if (count) count.textContent = String(groups.length);
        if (countLabel) countLabel.textContent = "个文档分类";
        if (hint) hint.textContent = "选择分类查看文档";

        if (categoryGrid) {
          categoryGrid.replaceChildren(...groups.map((item, index) => createCategoryCard(item, index)));
          categoryGrid.hidden = groups.length === 0;
        }
        if (rootEmpty) rootEmpty.hidden = groups.length !== 0;
        if (newCategoryButton) newCategoryButton.hidden = !canEditDocuments;
        showRoot();
      } catch (error) {
        console.error(error);
        showError(error instanceof Error ? error.message : "暂时无法加载共享文档，请稍后重试。");
      }
    }

    async function loadCategory() {
      showLoading();
      const query = currentIsUncategorized
        ? "?uncategorized=1"
        : `?category=${encodeURIComponent(currentCategory || "")}`;

      try {
        const data = await apiRequest(`/api/documents${query}`);
        const documents: DocumentItem[] = (Array.isArray(data.documents) ? data.documents : []).sort((a, b) => a.name.localeCompare(b.name, "zh-Hans-CN"));
        const displayName = currentIsUncategorized ? "未分类文档" : (data.category || currentCategory || "文档分类");

        if (currentCategoryTitle) currentCategoryTitle.textContent = displayName;
        if (currentCategoryDescription) {
          currentCategoryDescription.textContent = currentIsUncategorized
            ? "尚未归入具体分类的文档。"
            : `“${displayName}”中的 Markdown 文档`;
        }
        if (categoryDocumentCount) categoryDocumentCount.textContent = String(documents.length);
        if (count) count.textContent = String(documents.length);
        if (countLabel) countLabel.textContent = "篇 Markdown 文档";
        if (hint) hint.textContent = currentIsUncategorized
          ? "选择文档即可阅读或编辑"
          : "选择文档即可阅读或编辑";
        if (newCategoryButton) newCategoryButton.hidden = true;
        if (deleteCategoryButton) deleteCategoryButton.hidden = currentIsUncategorized || !canEditDocuments;

        if (documentList) {
          documentList.replaceChildren(...documents.map((item, index) => createDocumentRow(item, index)));
          documentList.hidden = documents.length === 0;
        }
        if (categoryEmpty) categoryEmpty.hidden = documents.length !== 0;
        showCategory();
      } catch (error) {
        console.error(error);
        showError(error instanceof Error ? error.message : "读取分类文档失败。");
      }
    }

    async function loadFromLocation() {
      const params = new URLSearchParams(window.location.search);
      const category = params.get("category");
      const uncategorized = params.get("uncategorized") === "1";
      if (category !== null) {
        currentCategory = category;
        currentIsUncategorized = false;
        await loadCategory();
      } else if (uncategorized) {
        currentCategory = null;
        currentIsUncategorized = true;
        await loadCategory();
      } else {
        currentCategory = null;
        currentIsUncategorized = false;
        await loadRoot();
      }
    }

    function showDialogError(target: HTMLElement | null, message: string) {
      if (!target) return;
      target.textContent = message;
      target.hidden = false;
    }

    function setButtonBusy(button: HTMLButtonElement | null, busy: boolean, idleText: string, busyText: string) {
      if (!button) return;
      button.disabled = busy;
      button.textContent = busy ? busyText : idleText;
    }

    function deleteDocument(item: DocumentItem) {
      pendingDeleteItem = item;
      if (deleteDocumentName) deleteDocumentName.textContent = `“${item.name}”`;
      if (deleteDocumentSummary) deleteDocumentSummary.value = "";
      if (deleteDocumentDialogError) deleteDocumentDialogError.hidden = true;
      deleteDocumentDialog?.showModal();
      deleteDocumentSummary?.focus();
    }

    deleteDocumentForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!pendingDeleteItem || busy) return;

      busy = true;
      if (deleteDocumentDialogError) deleteDocumentDialogError.hidden = true;
      setButtonBusy(deleteDocumentSubmit, true, "确认删除", "正在删除…");

      try {
        await apiRequest("/api/documents/content", {
          method: "DELETE",
          body: JSON.stringify({
            path: pendingDeleteItem.path,
            sha: pendingDeleteItem.sha,
            summary: deleteDocumentSummary?.value.trim() || "",
          }),
        });

        deleteDocumentDialog?.close();
        pendingDeleteItem = null;
        await loadCategory();
      } catch (error) {
        showDialogError(
          deleteDocumentDialogError,
          error instanceof Error ? error.message : "删除文档失败。"
        );
      } finally {
        busy = false;
        setButtonBusy(deleteDocumentSubmit, false, "确认删除", "正在删除…");
      }
    });

    async function deleteCurrentCategory() {
      if (!currentCategory || currentIsUncategorized) return;
      const confirmed = window.confirm(
        `确定删除空分类“${currentCategory}”吗？\n\n为避免误操作，分类中仍有文档或待审核记录时，系统会阻止删除。`
      );
      if (!confirmed) return;

      if (busy) return;
      busy = true;
      if (deleteCategoryButton) {
        deleteCategoryButton.disabled = true;
        deleteCategoryButton.textContent = "正在删除…";
      }

      try {
        await apiRequest("/api/documents/categories", {
          method: "DELETE",
          body: JSON.stringify({ name: currentCategory, confirmName: currentCategory }),
        });
        currentCategory = null;
        currentIsUncategorized = false;
        const url = makePageUrl();
        window.history.pushState({}, "", url);
        await loadRoot();
      } catch (error) {
        window.alert(error instanceof Error ? error.message : "删除分类失败。");
      } finally {
        busy = false;
        if (deleteCategoryButton) {
          deleteCategoryButton.disabled = false;
          deleteCategoryButton.textContent = "删除分类";
        }
      }
    }

    newCategoryButton?.addEventListener("click", () => {
      if (categoryDialogError) categoryDialogError.hidden = true;
      categoryForm?.reset();
      categoryDialog?.showModal();
      categoryNameInput?.focus();
    });

    rootEmptyCreate?.addEventListener("click", () => newCategoryButton?.click());

    categoryForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;
      const name = categoryNameInput?.value.trim() || "";
      if (!name) {
        showDialogError(categoryDialogError, "请输入分类名称。");
        return;
      }

      busy = true;
      setButtonBusy(createCategorySubmit, true, "创建分类", "正在创建…");
      if (categoryDialogError) categoryDialogError.hidden = true;

      try {
        await apiRequest("/api/documents/categories", {
          method: "POST",
          body: JSON.stringify({ name }),
        });
        categoryDialog?.close();
        await loadRoot();
      } catch (error) {
        showDialogError(categoryDialogError, error instanceof Error ? error.message : "创建分类失败。");
      } finally {
        busy = false;
        setButtonBusy(createCategorySubmit, false, "创建分类", "正在创建…");
      }
    });

    newDocumentButton?.addEventListener("click", () => {
      if (documentDialogError) documentDialogError.hidden = true;
      documentForm?.reset();
      if (newDocumentTarget) {
        newDocumentTarget.textContent = currentIsUncategorized
          ? "未分类文档（documents 根目录）"
          : `“${currentCategory || "未分类文档"}”`;
      }
      documentDialog?.showModal();
      documentNameInput?.focus();
    });

    documentForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;

      const name = documentNameInput?.value.trim() || "";
      const markdown = documentMarkdownInput?.value || "";
      if (!name) {
        showDialogError(documentDialogError, "请输入文档名称。");
        return;
      }

      busy = true;
      setButtonBusy(createDocumentSubmit, true, "创建文档", "正在创建…");
      if (documentDialogError) documentDialogError.hidden = true;

      try {
        await apiRequest("/api/documents", {
          method: "POST",
          body: JSON.stringify({
            category: currentIsUncategorized ? null : currentCategory,
            name,
            markdown,
            summary: documentSummaryInput?.value.trim() || "",
          }),
        });
        documentDialog?.close();
        await loadCategory();
      } catch (error) {
        showDialogError(documentDialogError, error instanceof Error ? error.message : "创建文档失败。");
      } finally {
        busy = false;
        setButtonBusy(createDocumentSubmit, false, "创建文档", "正在创建…");
      }
    });

    document.querySelectorAll<HTMLButtonElement>("[data-close-dialog]").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.closeDialog;
        if (id === "category-dialog") categoryDialog?.close();
        if (id === "document-dialog") documentDialog?.close();
        if (id === "delete-document-dialog") {
          pendingDeleteItem = null;
          deleteDocumentDialog?.close();
        }
      });
    });

    backButton?.addEventListener("click", navigateToRoot);
    deleteCategoryButton?.addEventListener("click", deleteCurrentCategory);
    refreshButton?.addEventListener("click", loadFromLocation);
    window.addEventListener("popstate", loadFromLocation);

    async function initializeDocumentPermissions() {
      const me = await getCurrentUser();
      canEditDocuments = Boolean(me?.access?.canWriteDocuments);
      if (newCategoryButton) newCategoryButton.hidden = !canEditDocuments;
      if (rootEmptyCreate) rootEmptyCreate.hidden = !canEditDocuments;
      if (newDocumentButton) newDocumentButton.hidden = !canEditDocuments;
      if (deleteCategoryButton && !canEditDocuments) deleteCategoryButton.hidden = true;
      await loadFromLocation();
    }

    initializeDocumentPermissions();
  </script>

