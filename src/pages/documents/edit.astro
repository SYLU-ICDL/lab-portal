---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title="编辑文档 | SYLU-ICDL"
	protectedPage={true}
	requiredRole="editor"
>
	<main class="editor-page">
		<div class="container editor-topbar">
			<a
				id="back-to-reader"
				href={`${base}documents`}
				class="back-link"
			>
				← 返回阅读
			</a>

			<div class="editor-topbar-note">
				编辑模式
			</div>
		</div>

		<div id="editor-loading" class="container editor-state-box">
			<div class="loading-ring"></div>
			<h1>正在载入编辑器</h1>
			<p>正在加载文档内容…</p>
		</div>

		<div
			id="editor-error"
			class="container editor-state-box"
			hidden
		>
			<div class="error-icon">!</div>
			<h1>无法编辑文档</h1>
			<p id="editor-error-message">请稍后重新尝试。</p>
		</div>

		<section
			id="editor-shell"
			class="container editor-shell"
			hidden
		>
			<header class="editor-header">
				<div>
					<div class="editor-kicker">
						共享文档 · 在线编辑
					</div>

					<h1 id="editor-title">文档</h1>

					<div class="editor-meta">
						<span id="editor-file-name"></span>
						<span>·</span>
						<span id="save-state">未修改</span>
					</div>
				</div>

				<div class="editor-actions">
					<button
						id="cancel-button"
						type="button"
						class="secondary-button"
					>
						取消
					</button>

					<button
						id="save-button"
						type="button"
						class="primary-button"
					>
						保存到 GitHub
					</button>
				</div>
			</header>

			<div class="editor-grid">
				<section class="editor-pane">
					<div class="pane-title">正文</div>

					<textarea
						id="markdown-editor"
						class="markdown-editor"
						spellcheck="false"
					></textarea>
				</section>

				<section class="preview-pane">
					<div class="pane-title">实时预览</div>

					<div
						id="markdown-preview"
						class="markdown-body preview-body"
					></div>
				</section>
			</div>

			<div
				id="save-message"
				class="save-message"
				hidden
			></div>
		</section>
	</main>

	<script>
		import { marked } from "marked";
		import DOMPurify from "dompurify";

		import {
			clearSession,
			getSessionToken,
		} from "../../lib/auth";

		const AUTH_WORKER =
			"https://sylu-icdl-auth.hugozhao6.workers.dev";

		const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

		const loading =
			document.querySelector<HTMLElement>("#editor-loading");
		const errorBox =
			document.querySelector<HTMLElement>("#editor-error");
		const errorMessage =
			document.querySelector<HTMLElement>("#editor-error-message");
		const shell =
			document.querySelector<HTMLElement>("#editor-shell");

		const title =
			document.querySelector<HTMLElement>("#editor-title");
		const fileName =
			document.querySelector<HTMLElement>("#editor-file-name");
		const saveState =
			document.querySelector<HTMLElement>("#save-state");
		const editor =
			document.querySelector<HTMLTextAreaElement>("#markdown-editor");
		const preview =
			document.querySelector<HTMLElement>("#markdown-preview");
		const saveButton =
			document.querySelector<HTMLButtonElement>("#save-button");
		const cancelButton =
			document.querySelector<HTMLButtonElement>("#cancel-button");
		const saveMessage =
			document.querySelector<HTMLElement>("#save-message");
		const backLink =
			document.querySelector<HTMLAnchorElement>("#back-to-reader");

		let path = "";
		let name = "";
		let sha = "";
		let originalMarkdown = "";
		let saving = false;

		marked.setOptions({
			gfm: true,
			breaks: false,
		});

		function showOnly(target: HTMLElement | null) {
			for (const el of [loading, errorBox, shell]) {
				if (el) el.hidden = el !== target;
			}
		}

		function render(markdown: string) {
			if (!preview) return;

			const html = marked.parse(markdown);

			preview.innerHTML = DOMPurify.sanitize(
				html as string,
				{ USE_PROFILES: { html: true } }
			);
		}

		function setMessage(
			message: string,
			type: "success" | "error"
		) {
			if (!saveMessage) return;

			saveMessage.hidden = false;
			saveMessage.className =
				`save-message ${type}`;
			saveMessage.textContent = message;
		}

		function clearMessage() {
			if (!saveMessage) return;
			saveMessage.hidden = true;
			saveMessage.textContent = "";
			saveMessage.className = "save-message";
		}

		async function load() {
			showOnly(loading);

			const session = getSessionToken();
			if (!session) return;

			const params =
				new URLSearchParams(window.location.search);
			path = params.get("path") || "";

			if (!path) {
				if (errorMessage) {
					errorMessage.textContent = "缺少文档路径参数。";
				}
				showOnly(errorBox);
				return;
			}

			try {
				const api = new URL(
					`${AUTH_WORKER}/api/documents/content`
				);
				api.searchParams.set("path", path);

				const response = await fetch(api.toString(), {
					headers: {
						Authorization: `Bearer ${session}`,
					},
					cache: "no-store",
				});

				if (response.status === 401) {
					clearSession();
					window.location.reload();
					return;
				}

				const data = await response.json();

				if (!response.ok) {
					if (errorMessage) {
						errorMessage.textContent =
							data.message || "读取文档失败。";
					}
					showOnly(errorBox);
					return;
				}

				name = data.name;
				sha = data.sha;
				originalMarkdown = data.markdown;

				if (title) title.textContent = data.name;
				if (fileName) fileName.textContent = data.fileName;
				if (editor) editor.value = originalMarkdown;

				render(originalMarkdown);

				if (backLink) {
					backLink.href =
						`${base}documents/view?path=` +
						encodeURIComponent(path);
				}

				document.title =
					`编辑 ${data.name} | SYLU-ICDL`;

				showOnly(shell);
			} catch (error) {
				console.error(error);

				if (errorMessage) {
					errorMessage.textContent =
						"无法连接共享文档服务。";
				}

				showOnly(errorBox);
			}
		}

		async function save() {
			if (!editor || saving) return;

			const session = getSessionToken();
			if (!session) return;

			if (editor.value === originalMarkdown) {
				setMessage("正文没有变化，无需保存。", "success");
				return;
			}

			saving = true;
			clearMessage();

			if (saveButton) {
				saveButton.disabled = true;
				saveButton.textContent = "正在保存…";
			}

			if (saveState) {
				saveState.textContent = "正在保存";
			}

			try {
				const response = await fetch(
					`${AUTH_WORKER}/api/documents/content`,
					{
						method: "PUT",
						headers: {
							Authorization: `Bearer ${session}`,
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							path,
							markdown: editor.value,
							sha,
							message:
								`Update ${name} via SYLU-ICDL Portal`,
						}),
					}
				);

				if (response.status === 401) {
					clearSession();
					window.location.reload();
					return;
				}

				const data = await response.json();

				if (!response.ok) {
					setMessage(
						data.message || "保存失败。",
						"error"
					);

					if (saveState) {
						saveState.textContent = "保存失败";
					}
					return;
				}

				originalMarkdown = editor.value;

				if (data.newSha) {
					sha = data.newSha;
				}

				if (saveState) {
					saveState.textContent = "已保存";
				}

				setMessage(
					"保存成功。",
					"success"
				);
			} catch (error) {
				console.error(error);

				setMessage(
					"暂时无法保存，请检查网络后重试。",
					"error"
				);

				if (saveState) {
					saveState.textContent = "保存失败";
				}
			} finally {
				saving = false;

				if (saveButton) {
					saveButton.disabled = false;
					saveButton.textContent = "保存到 GitHub";
				}
			}
		}

		editor?.addEventListener("input", () => {
			render(editor.value);

			if (saveState) {
				saveState.textContent =
					editor.value === originalMarkdown
						? "未修改"
						: "有未保存修改";
			}

			clearMessage();
		});

		saveButton?.addEventListener("click", save);

		cancelButton?.addEventListener("click", () => {
			window.location.href =
				`${base}documents/view?path=` +
				encodeURIComponent(path);
		});

		load();
	</script>

	<style is:global>
		.editor-page {
			min-height: calc(100vh - 68px);
			padding: 28px 0 60px;
			background: #f5f7fb;
		}

		.editor-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			margin-bottom: 18px;
		}

		.back-link {
			color: #536078;
			font-size: 14px;
			font-weight: 700;
		}

		.back-link:hover {
			color: #2563eb;
		}

		.editor-topbar-note {
			color: #98a2b2;
			font-size: 12px;
		}

		.editor-shell {
			overflow: hidden;
			border: 1px solid #e0e6ee;
			border-radius: 16px;
			background: #ffffff;
			box-shadow: 0 14px 40px rgba(34,51,84,.055);
		}

		.editor-shell[hidden],
		.editor-state-box[hidden] {
			display: none;
		}

		.editor-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			padding: 24px 28px;
			border-bottom: 1px solid #e8edf3;
			background: linear-gradient(135deg,#fff,#f8fbff);
		}

		.editor-kicker {
			margin-bottom: 7px;
			color: #2563eb;
			font-size: 12px;
			font-weight: 800;
		}

		.editor-header h1 {
			margin: 0 0 7px;
			color: #172033;
			font-size: 27px;
		}

		.editor-meta {
			display: flex;
			gap: 7px;
			color: #8a95a6;
			font-size: 12px;
		}

		.editor-actions {
			display: flex;
			gap: 10px;
		}

		.editor-actions button {
			height: 40px;
			padding: 0 16px;
			border-radius: 9px;
			cursor: pointer;
			font-weight: 700;
		}

		.editor-actions .secondary-button {
			border: 1px solid #d7dee8;
			background: #ffffff;
			color: #536078;
		}

		.editor-actions .primary-button {
			border: 1px solid #2563eb;
			background: #2563eb;
			color: #ffffff;
		}

		.editor-actions .primary-button:disabled {
			opacity: .65;
			cursor: wait;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: minmax(0,1fr) minmax(0,1fr);
			min-height: 680px;
		}

		.editor-pane,
		.preview-pane {
			display: flex;
			min-width: 0;
			flex-direction: column;
		}

		.editor-pane {
			border-right: 1px solid #e2e7ee;
		}

		.pane-title {
			padding: 12px 16px;
			border-bottom: 1px solid #e5eaf0;
			background: #fafbfd;
			color: #7b8799;
			font-size: 12px;
			font-weight: 800;
		}

		.markdown-editor {
			width: 100%;
			min-height: 680px;
			flex: 1;
			padding: 22px;
			resize: vertical;
			border: 0;
			outline: none;
			background: #fbfcfe;
			color: #253044;
			font-family: Consolas, monospace;
			font-size: 14px;
			line-height: 1.75;
		}

		.preview-pane {
			background: #ffffff;
		}

		.markdown-body {
			padding: 28px 32px 52px;
			color: #344054;
			font-size: 15px;
			line-height: 1.8;
			overflow-wrap: anywhere;
		}

		.markdown-body h1,
		.markdown-body h2,
		.markdown-body h3 {
			color: #172033;
			line-height: 1.4;
		}

		.markdown-body h1 {
			margin: 0 0 24px;
			padding-bottom: 13px;
			border-bottom: 1px solid #e9edf2;
			font-size: 28px;
		}

		.markdown-body h2 {
			margin: 34px 0 16px;
			padding-bottom: 9px;
			border-bottom: 1px solid #edf0f4;
			font-size: 22px;
		}

		.markdown-body h3 {
			margin: 25px 0 10px;
			font-size: 18px;
		}

		.markdown-body p {
			margin: 0 0 17px;
		}

		.markdown-body code {
			padding: 2px 6px;
			border-radius: 5px;
			background: #f0f3f7;
			color: #c0395a;
		}

		.markdown-body pre {
			overflow-x: auto;
			padding: 17px;
			border-radius: 9px;
			background: #f6f8fa;
		}

		.markdown-body table {
			display: block;
			width: 100%;
			overflow-x: auto;
			border-collapse: collapse;
		}

		.markdown-body th,
		.markdown-body td {
			padding: 9px 12px;
			border: 1px solid #dfe5ec;
		}

		.save-message {
			margin: 14px 18px 18px;
			padding: 11px 13px;
			border-radius: 8px;
			font-size: 13px;
		}

		.save-message[hidden] {
			display: none;
		}

		.save-message.success {
			border: 1px solid #bfe7cf;
			background: #effbf4;
			color: #23774b;
		}

		.save-message.error {
			border: 1px solid #f0c8c8;
			background: #fff4f4;
			color: #aa3939;
		}

		.editor-state-box {
			display: flex;
			min-height: 420px;
			align-items: center;
			justify-content: center;
			flex-direction: column;
			gap: 10px;
			border: 1px solid #e2e7ee;
			border-radius: 16px;
			background: #ffffff;
			text-align: center;
			color: #718096;
		}

		.loading-ring {
			width: 30px;
			height: 30px;
			border: 3px solid #e4eaf2;
			border-top-color: #2563eb;
			border-radius: 50%;
			animation: spin .8s linear infinite;
		}

		.error-icon {
			display: flex;
			width: 48px;
			height: 48px;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: #fff0f0;
			color: #c54040;
			font-weight: 800;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		@media (max-width: 1050px) {
			.editor-grid {
				grid-template-columns: 1fr;
			}

			.editor-pane {
				border-right: 0;
				border-bottom: 1px solid #e2e7ee;
			}
		}

		@media (max-width: 720px) {
			.editor-header {
				align-items: flex-start;
				flex-direction: column;
			}

			.editor-actions {
				width: 100%;
			}

			.editor-actions button {
				flex: 1;
			}
		}
	</style>
</BaseLayout>
