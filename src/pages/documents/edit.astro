---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title="编辑文档 | SYLU-ICDL"
	protectedPage={true}
	requiredRole="editor"
>
	<main class="editor-page">
		<div class="container editor-topbar">
			<a
				id="back-to-reader"
				href={`${base}documents`}
				class="back-link"
			>
				← 返回阅读
			</a>

			<div class="editor-topbar-note">
				编辑模式
			</div>
		</div>

		<div id="editor-loading" class="container editor-state-box">
			<div class="loading-ring"></div>
			<h1>正在载入编辑器</h1>
			<p>正在加载文档内容…</p>
		</div>

		<div
			id="editor-error"
			class="container editor-state-box"
			hidden
		>
			<div class="error-icon">!</div>
			<h1>无法编辑文档</h1>
			<p id="editor-error-message">请稍后重新尝试。</p>
		</div>

		<section
			id="editor-shell"
			class="container editor-shell"
			hidden
		>
			<header class="editor-header">
				<div>
					<div class="editor-kicker">
						共享文档 · 在线编辑
					</div>

					<h1 id="editor-title">文档</h1>

					<div class="editor-meta">
						<span id="editor-file-name"></span>
						<span>·</span>
						<span id="save-state">未修改</span>
					</div>
				</div>

				<div class="editor-actions">
					<button
						id="cancel-button"
						type="button"
						class="secondary-button"
					>
						取消
					</button>

					<button
						id="save-button"
						type="button"
						class="primary-button"
					>
						保存
					</button>
				</div>
			</header>

			<div class="editor-grid">
				<section class="editor-pane">
					<div class="pane-title">正文</div>

					<div class="attachment-paste-hint">
						<div>
							<strong>支持直接粘贴图片</strong>
							<span>复制截图或图片后，在正文中按 Ctrl + V 即可插入。</span>
						</div>
						<span id="attachment-upload-state" class="attachment-upload-state"></span>
					</div>

					<textarea
						id="markdown-editor"
						class="markdown-editor"
						spellcheck="false"
					></textarea>
				</section>

				<section class="preview-pane">
					<div class="pane-title">实时预览</div>

					<div
						id="markdown-preview"
						class="markdown-body preview-body"
					></div>
				</section>
			</div>

			<div
				id="save-message"
				class="save-message"
				hidden
			></div>
		</section>
	</main>

	<dialog id="save-dialog" class="save-dialog">
		<form id="save-form" class="save-dialog-form">
			<div class="editor-kicker">保存文档</div>
			<h2>确认保存</h2>
			<p>可以填写本次修改的简要说明，留空也可以直接保存。</p>

			<label for="save-summary">
				<span>修改说明（可选）</span>
				<textarea
					id="save-summary"
					rows="4"
					maxlength="120"
					placeholder="例如：补充实验步骤与注意事项"
				></textarea>
			</label>

			<div class="save-dialog-actions">
				<button id="save-dialog-cancel" type="button" class="secondary-button">取消</button>
				<button id="save-dialog-submit" type="submit" class="primary-button">保存</button>
			</div>
		</form>
	</dialog>

	<script>
		import { marked } from "marked";
		import DOMPurify from "dompurify";

		import {
			clearSession,
			getSessionToken,
		} from "../../lib/auth";

		const AUTH_WORKER =
			"https://sylu-icdl-auth.hugozhao6.workers.dev";

		const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

		const loading =
			document.querySelector<HTMLElement>("#editor-loading");
		const errorBox =
			document.querySelector<HTMLElement>("#editor-error");
		const errorMessage =
			document.querySelector<HTMLElement>("#editor-error-message");
		const shell =
			document.querySelector<HTMLElement>("#editor-shell");

		const title =
			document.querySelector<HTMLElement>("#editor-title");
		const fileName =
			document.querySelector<HTMLElement>("#editor-file-name");
		const saveState =
			document.querySelector<HTMLElement>("#save-state");
		const editor =
			document.querySelector<HTMLTextAreaElement>("#markdown-editor");
		const preview =
			document.querySelector<HTMLElement>("#markdown-preview");
		const saveButton =
			document.querySelector<HTMLButtonElement>("#save-button");
		const cancelButton =
			document.querySelector<HTMLButtonElement>("#cancel-button");
		const saveMessage =
			document.querySelector<HTMLElement>("#save-message");
		const backLink =
			document.querySelector<HTMLAnchorElement>("#back-to-reader");
		const attachmentUploadState =
			document.querySelector<HTMLElement>("#attachment-upload-state");

		const saveDialog =
			document.querySelector<HTMLDialogElement>("#save-dialog");
		const saveForm =
			document.querySelector<HTMLFormElement>("#save-form");
		const saveSummary =
			document.querySelector<HTMLTextAreaElement>("#save-summary");
		const saveDialogCancel =
			document.querySelector<HTMLButtonElement>("#save-dialog-cancel");
		const saveDialogSubmit =
			document.querySelector<HTMLButtonElement>("#save-dialog-submit");

		let path = "";
		let name = "";
		let sha = "";
		let originalMarkdown = "";
		let saving = false;
		let uploadingAttachment = false;
		let syncingPaneScroll = false;
		const attachmentObjectUrls = new Map<string, string>();
		const attachmentFetches = new Map<string, Promise<string | null>>();

		function paneScrollSyncEnabled() {
			return window.matchMedia("(min-width: 1051px)").matches;
		}

		function syncPaneScroll(
			source: HTMLElement,
			target: HTMLElement
		) {
			if (!paneScrollSyncEnabled() || syncingPaneScroll) return;

			const sourceMax = Math.max(
				0,
				source.scrollHeight - source.clientHeight
			);
			const targetMax = Math.max(
				0,
				target.scrollHeight - target.clientHeight
			);

			const ratio =
				sourceMax > 0
					? Math.min(1, Math.max(0, source.scrollTop / sourceMax))
					: 0;

			syncingPaneScroll = true;
			target.scrollTop = ratio * targetMax;

			window.requestAnimationFrame(() => {
				syncingPaneScroll = false;
			});
		}

		marked.setOptions({
			gfm: true,
			breaks: false,
		});

		function showOnly(target: HTMLElement | null) {
			for (const el of [loading, errorBox, shell]) {
				if (el) el.hidden = el !== target;
			}
		}

		function resolveAttachmentRepositoryPath(src: string, documentPath: string) {
			if (!src || !documentPath) return null;
			if (/^(?:https?:|data:|blob:|\/\/)/i.test(src)) return null;

			let clean = src.split("#")[0].split("?")[0];
			try { clean = decodeURIComponent(clean); } catch {}
			clean = clean.replace(/\\/g, "/");
			if (!clean.includes("_attachments/")) return null;

			const stack = documentPath.split("/").slice(0, -1);
			for (const segment of clean.split("/")) {
				if (!segment || segment === ".") continue;
				if (segment === "..") {
					if (stack.length > 1) stack.pop();
					continue;
				}
				stack.push(segment);
			}

			const resolved = stack.join("/");
			return resolved.includes("/_attachments/") ? resolved : null;
		}

		async function attachmentObjectUrl(repositoryPath: string) {
			const cached = attachmentObjectUrls.get(repositoryPath);
			if (cached) return cached;

			const pending = attachmentFetches.get(repositoryPath);
			if (pending) return pending;

			const task = (async () => {
				const session = getSessionToken();
				if (!session) return null;

				const url = new URL(`${AUTH_WORKER}/api/documents/attachment`);
				url.searchParams.set("path", repositoryPath);

				const response = await fetch(url.toString(), {
					headers: { Authorization: `Bearer ${session}` },
					cache: "no-store",
				});

				if (!response.ok) return null;
				const blob = await response.blob();
				const objectUrl = URL.createObjectURL(blob);
				attachmentObjectUrls.set(repositoryPath, objectUrl);
				return objectUrl;
			})().finally(() => attachmentFetches.delete(repositoryPath));

			attachmentFetches.set(repositoryPath, task);
			return task;
		}

		async function hydrateProtectedImages(container: HTMLElement, documentPath: string) {
			const images = Array.from(container.querySelectorAll<HTMLImageElement>("img"));

			await Promise.all(images.map(async (image) => {
				const raw = image.getAttribute("src") || "";
				const repositoryPath = resolveAttachmentRepositoryPath(raw, documentPath);
				if (!repositoryPath) return;

				image.classList.add("attachment-loading");
				const objectUrl = await attachmentObjectUrl(repositoryPath);
				image.classList.remove("attachment-loading");

				if (objectUrl && image.isConnected) {
					image.src = objectUrl;
				} else if (image.isConnected) {
					image.classList.add("attachment-load-error");
					image.alt = image.alt || "图片暂时无法加载";
				}
			}));
		}

		function render(markdown: string) {
			if (!preview) return;

			const html = marked.parse(markdown);

			preview.innerHTML = DOMPurify.sanitize(
				html as string,
				{ USE_PROFILES: { html: true } }
			);

			void hydrateProtectedImages(preview, path);

			if (editor && paneScrollSyncEnabled()) {
				window.requestAnimationFrame(() => {
					syncPaneScroll(editor, preview);
				});
			}
		}

		function setMessage(
			message: string,
			type: "success" | "error"
		) {
			if (!saveMessage) return;

			saveMessage.hidden = false;
			saveMessage.className =
				`save-message ${type}`;
			saveMessage.textContent = message;
		}

		function clearMessage() {
			if (!saveMessage) return;
			saveMessage.hidden = true;
			saveMessage.textContent = "";
			saveMessage.className = "save-message";
		}

		async function load() {
			showOnly(loading);

			const session = getSessionToken();
			if (!session) return;

			const params =
				new URLSearchParams(window.location.search);
			path = params.get("path") || "";

			if (!path) {
				if (errorMessage) {
					errorMessage.textContent = "缺少文档路径参数。";
				}
				showOnly(errorBox);
				return;
			}

			try {
				const api = new URL(
					`${AUTH_WORKER}/api/documents/content`
				);
				api.searchParams.set("path", path);

				const response = await fetch(api.toString(), {
					headers: {
						Authorization: `Bearer ${session}`,
					},
					cache: "no-store",
				});

				if (response.status === 401) {
					clearSession();
					window.location.reload();
					return;
				}

				const data = await response.json();

				if (!response.ok) {
					if (errorMessage) {
						errorMessage.textContent =
							data.message || "读取文档失败。";
					}
					showOnly(errorBox);
					return;
				}

				name = data.name;
				sha = data.sha;
				originalMarkdown = data.markdown;

				if (title) title.textContent = data.name;
				if (fileName) fileName.textContent = data.fileName;
				if (editor) editor.value = originalMarkdown;

				render(originalMarkdown);

				if (backLink) {
					backLink.href =
						`${base}documents/view?path=` +
						encodeURIComponent(path);
				}

				document.title =
					`编辑 ${data.name} | SYLU-ICDL`;

				showOnly(shell);
			} catch (error) {
				console.error(error);

				if (errorMessage) {
					errorMessage.textContent =
						"无法连接共享文档服务。";
				}

				showOnly(errorBox);
			}
		}

		function openSaveDialog() {
			if (!editor || saving) return;

			if (editor.value === originalMarkdown) {
				setMessage("正文没有变化，无需保存。", "success");
				return;
			}

			if (saveSummary) saveSummary.value = "";
			saveDialog?.showModal();
			saveSummary?.focus();
		}

		async function save(summary: string) {
			if (!editor || saving) return;

			const session = getSessionToken();
			if (!session) return;

			if (editor.value === originalMarkdown) {
				setMessage("正文没有变化，无需保存。", "success");
				return;
			}

			saving = true;
			clearMessage();

			if (saveButton) {
				saveButton.disabled = true;
				saveButton.textContent = "正在保存…";
			}

			if (saveDialogSubmit) {
				saveDialogSubmit.disabled = true;
				saveDialogSubmit.textContent = "正在保存…";
			}

			if (saveState) {
				saveState.textContent = "正在保存";
			}

			try {
				const response = await fetch(
					`${AUTH_WORKER}/api/documents/content`,
					{
						method: "PUT",
						headers: {
							Authorization: `Bearer ${session}`,
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							path,
							markdown: editor.value,
							sha,
							summary,
						}),
					}
				);

				if (response.status === 401) {
					clearSession();
					window.location.reload();
					return;
				}

				const data = await response.json();

				if (!response.ok) {
					setMessage(data.message || "保存失败。", "error");

					if (saveState) {
						saveState.textContent = "保存失败";
					}
					return;
				}

				originalMarkdown = editor.value;

				if (data.newSha) {
					sha = data.newSha;
				}

				if (saveState) {
					saveState.textContent = "已保存";
				}

				setMessage("保存成功。", "success");
				saveDialog?.close();
			} catch (error) {
				console.error(error);

				setMessage(
					"暂时无法保存，请检查网络后重试。",
					"error"
				);

				if (saveState) {
					saveState.textContent = "保存失败";
				}
			} finally {
				saving = false;

				if (saveButton) {
					saveButton.disabled = false;
					saveButton.textContent = "保存";
				}

				if (saveDialogSubmit) {
					saveDialogSubmit.disabled = false;
					saveDialogSubmit.textContent = "保存";
				}
			}
		}

		function setAttachmentState(message: string, type: "normal" | "error" = "normal") {
			if (!attachmentUploadState) return;
			attachmentUploadState.textContent = message;
			attachmentUploadState.classList.toggle("is-error", type === "error");
		}

		function fileToBase64(file: File) {
			return new Promise<string>((resolve, reject) => {
				const reader = new FileReader();
				reader.onload = () => {
					const value = String(reader.result || "");
					const comma = value.indexOf(",");
					if (comma < 0) reject(new Error("无法读取图片内容。"));
					else resolve(value.slice(comma + 1));
				};
				reader.onerror = () => reject(new Error("无法读取图片内容。"));
				reader.readAsDataURL(file);
			});
		}

		function insertMarkdownAtCursor(markdown: string) {
			if (!editor) return;
			const start = editor.selectionStart ?? editor.value.length;
			const end = editor.selectionEnd ?? start;
			const before = editor.value.slice(0, start);
			const after = editor.value.slice(end);
			const prefix = before && !before.endsWith("\n") ? "\n" : "";
			const suffix = after && !after.startsWith("\n") ? "\n" : "";
			const insertion = `${prefix}${markdown}${suffix}`;

			editor.value = before + insertion + after;
			const next = before.length + insertion.length;
			editor.selectionStart = next;
			editor.selectionEnd = next;
			editor.dispatchEvent(new Event("input", { bubbles: true }));
		}

		async function uploadPastedImage(file: File) {
			const session = getSessionToken();
			if (!session) throw new Error("登录状态已失效，请重新登录。");

			const supported = new Set([
				"image/png",
				"image/jpeg",
				"image/webp",
				"image/gif",
			]);

			if (!supported.has(file.type)) {
				throw new Error("暂时支持 PNG、JPG、WebP 和 GIF 图片。");
			}

			if (file.size > 5 * 1024 * 1024) {
				throw new Error("单张图片不能超过 5 MB。");
			}

			const base64 = await fileToBase64(file);
			const response = await fetch(`${AUTH_WORKER}/api/documents/attachments`, {
				method: "POST",
				headers: {
					Authorization: `Bearer ${session}`,
					"Content-Type": "application/json",
				},
				body: JSON.stringify({
					documentPath: path,
					mimeType: file.type,
					base64,
				}),
			});

			if (response.status === 401) {
				clearSession();
				window.location.reload();
				throw new Error("登录状态已失效。");
			}

			const data = await response.json();
			if (!response.ok) {
				throw new Error(data.message || "图片上传失败。");
			}

			return data;
		}

		editor?.addEventListener("paste", async (event) => {
			const files = Array.from(event.clipboardData?.items || [])
				.filter((item) => item.kind === "file" && item.type.startsWith("image/"))
				.map((item) => item.getAsFile())
				.filter((file): file is File => Boolean(file));

			if (files.length === 0) return;
			event.preventDefault();

			if (uploadingAttachment || !editor) return;
			uploadingAttachment = true;
			editor.readOnly = true;
			clearMessage();

			try {
				for (let index = 0; index < files.length; index++) {
					setAttachmentState(`正在上传图片 ${index + 1}/${files.length}…`);
					const data = await uploadPastedImage(files[index]);
					insertMarkdownAtCursor(`![图片](${data.relativePath})`);
				}
				setAttachmentState(files.length > 1 ? `已插入 ${files.length} 张图片` : "图片已插入");
			} catch (error) {
				console.error(error);
				const message = error instanceof Error ? error.message : "图片上传失败。";
				setAttachmentState(message, "error");
				setMessage(message, "error");
			} finally {
				uploadingAttachment = false;
				editor.readOnly = false;
				editor.focus();
			}
		});

		editor?.addEventListener("input", () => {
			render(editor.value);

			if (saveState) {
				saveState.textContent =
					editor.value === originalMarkdown
						? "未修改"
						: "有未保存修改";
			}

			clearMessage();
		});

		editor?.addEventListener("scroll", () => {
			if (preview) syncPaneScroll(editor, preview);
		});

		preview?.addEventListener("scroll", () => {
			if (editor) syncPaneScroll(preview, editor);
		});

		window.addEventListener("resize", () => {
			if (editor && preview && paneScrollSyncEnabled()) {
				syncPaneScroll(editor, preview);
			}
		});

		saveButton?.addEventListener("click", openSaveDialog);

		saveForm?.addEventListener("submit", async (event) => {
			event.preventDefault();
			await save(saveSummary?.value.trim() || "");
		});

		saveDialogCancel?.addEventListener("click", () => {
			saveDialog?.close();
		});

		cancelButton?.addEventListener("click", () => {
			window.location.href =
				`${base}documents/view?path=` +
				encodeURIComponent(path);
		});

		window.addEventListener("beforeunload", () => {
			for (const objectUrl of attachmentObjectUrls.values()) {
				URL.revokeObjectURL(objectUrl);
			}
		});

		load();
	</script>

	<style is:global>
		.editor-page {
			min-height: calc(100vh - 68px);
			padding: 28px 0 60px;
			background: #f5f7fb;
		}

		.editor-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			margin-bottom: 18px;
		}

		.back-link {
			color: #536078;
			font-size: 14px;
			font-weight: 700;
		}

		.back-link:hover {
			color: #2563eb;
		}

		.editor-topbar-note {
			color: #98a2b2;
			font-size: 12px;
		}

		.editor-shell {
			overflow: hidden;
			border: 1px solid #e0e6ee;
			border-radius: 16px;
			background: #ffffff;
			box-shadow: 0 14px 40px rgba(34,51,84,.055);
		}

		.editor-shell[hidden],
		.editor-state-box[hidden] {
			display: none;
		}

		.editor-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 24px;
			padding: 24px 28px;
			border-bottom: 1px solid #e8edf3;
			background: linear-gradient(135deg,#fff,#f8fbff);
		}

		.editor-kicker {
			margin-bottom: 7px;
			color: #2563eb;
			font-size: 12px;
			font-weight: 800;
		}

		.editor-header h1 {
			margin: 0 0 7px;
			color: #172033;
			font-size: 27px;
		}

		.editor-meta {
			display: flex;
			gap: 7px;
			color: #8a95a6;
			font-size: 12px;
		}

		.editor-actions {
			display: flex;
			gap: 10px;
		}

		.editor-actions button {
			height: 40px;
			padding: 0 16px;
			border-radius: 9px;
			cursor: pointer;
			font-weight: 700;
		}

		.editor-actions .secondary-button {
			border: 1px solid #d7dee8;
			background: #ffffff;
			color: #536078;
		}

		.editor-actions .primary-button {
			border: 1px solid #2563eb;
			background: #2563eb;
			color: #ffffff;
		}

		.editor-actions .primary-button:disabled {
			opacity: .65;
			cursor: wait;
		}

		.editor-grid {
			display: grid;
			grid-template-columns: minmax(0,1fr) minmax(0,1fr);
			min-height: 680px;
		}

		.editor-pane,
		.preview-pane {
			display: flex;
			min-width: 0;
			flex-direction: column;
		}

		.editor-pane {
			border-right: 1px solid #e2e7ee;
		}

		.pane-title {
			padding: 12px 16px;
			border-bottom: 1px solid #e5eaf0;
			background: #fafbfd;
			color: #7b8799;
			font-size: 12px;
