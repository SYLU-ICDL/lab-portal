---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title="文档阅读 | SYLU-ICDL"
	protectedPage={true}
>
	<main class="reader-page">

		<div class="container reader-topbar">
			<a
				id="back-to-documents"
				href={`${base}documents`}
				class="back-link"
			>
				← 返回共享文档
			</a>

			<div class="reader-topbar-actions">
				<div class="reader-source">
					SYLU-ICDL / shared-docs
				</div>

				<a
					id="edit-document-link"
					class="edit-document-link"
					href="#"
					hidden
				>
					编辑文档
				</a>
			</div>
		</div>

		<div id="reader-loading" class="container reader-state">
			<div class="loading-ring" aria-hidden="true"></div>
			<h1>正在读取文档</h1>
			<p>正在从 GitHub 私有仓库加载 Markdown 内容…</p>
		</div>

		<div
			id="reader-error"
			class="container reader-state error-state"
			hidden
		>
			<div class="state-icon">!</div>
			<h1>无法打开文档</h1>
			<p id="reader-error-message">
				文档不存在或当前账号没有读取权限。
			</p>
		</div>

		<section
			id="reader-layout"
			class="container reader-layout"
			hidden
		>
			<article class="document-shell">
				<header class="document-header">
					<div class="document-kicker">
						共享文档
					</div>

					<h1 id="document-title">
						文档
					</h1>

					<div class="document-meta">
						<span id="document-file-name"></span>
						<span class="meta-divider">·</span>
						<span>Markdown</span>
					</div>
				</header>

				<div
					id="markdown-content"
					class="markdown-body"
				></div>
			</article>

			<aside
				id="toc-panel"
				class="toc-panel"
				hidden
			>
				<div class="toc-title">
					本文目录
				</div>

				<nav
					id="toc-list"
					class="toc-list"
				></nav>
			</aside>
		</section>

	</main>

	<script>
		import { marked } from "marked";
		import DOMPurify from "dompurify";

		import {
			clearSession,
			getCurrentUser,
			getSessionToken,
		} from "../../lib/auth";

		const AUTH_WORKER =
			"https://sylu-icdl-auth.hugozhao6.workers.dev";

		const loading =
			document.querySelector<HTMLElement>("#reader-loading");
		const errorBox =
			document.querySelector<HTMLElement>("#reader-error");
		const errorMessage =
			document.querySelector<HTMLElement>("#reader-error-message");
		const layout =
			document.querySelector<HTMLElement>("#reader-layout");
		const title =
			document.querySelector<HTMLElement>("#document-title");
		const fileName =
			document.querySelector<HTMLElement>("#document-file-name");
		const content =
			document.querySelector<HTMLElement>("#markdown-content");
		const tocPanel =
			document.querySelector<HTMLElement>("#toc-panel");
		const tocList =
			document.querySelector<HTMLElement>("#toc-list");
		const editDocumentLink =
			document.querySelector<HTMLAnchorElement>("#edit-document-link");
		const backToDocuments =
			document.querySelector<HTMLAnchorElement>("#back-to-documents");

		const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

		function showOnly(
			target: HTMLElement | null
		) {
			for (const element of [
				loading,
				errorBox,
				layout,
			]) {
				if (element) {
					element.hidden = element !== target;
				}
			}
		}

		function createTableOfContents() {
			if (!content || !tocList || !tocPanel) {
				return;
			}

			const headings = Array.from(
				content.querySelectorAll<HTMLElement>(
					"h2, h3"
				)
			);

			if (headings.length === 0) {
				tocPanel.hidden = true;
				return;
			}

			const links = headings.map(
				(heading, index) => {
					const id = `section-${index + 1}`;
					heading.id = id;

					const link =
						document.createElement("a");

					link.href = `#${id}`;
					link.textContent =
						heading.textContent || "未命名章节";

					link.className =
						heading.tagName === "H3"
							? "toc-link toc-link-level-3"
							: "toc-link";

					return link;
				}
			);

			tocList.replaceChildren(...links);
			tocPanel.hidden = false;
		}

		async function loadDocument() {
			showOnly(loading);

			const session = getSessionToken();

			if (!session) {
				return;
			}

			const params =
				new URLSearchParams(window.location.search);

			const path = params.get("path");

			if (!path) {
				if (errorMessage) {
					errorMessage.textContent =
						"缺少文档路径参数。";
				}

				showOnly(errorBox);
				return;
			}

			try {
				const apiUrl = new URL(
					`${AUTH_WORKER}/api/documents/content`
				);

				apiUrl.searchParams.set("path", path);

				const response = await fetch(
					apiUrl.toString(),
					{
						headers: {
							Authorization:
								`Bearer ${session}`,
						},
						cache: "no-store",
					}
				);

				if (response.status === 401) {
					clearSession();
					window.location.reload();
					return;
				}

				const data = await response.json();

				if (!response.ok) {
					if (errorMessage) {
						errorMessage.textContent =
							data.message ||
							"读取文档失败。";
					}

					showOnly(errorBox);
					return;
				}

				if (
					typeof data.markdown !== "string"
				) {
					throw new Error(
						"Invalid markdown response"
					);
				}

				if (title) {
					title.textContent = data.name;
				}

				if (fileName) {
					fileName.textContent =
						data.fileName;
				}

				const me = await getCurrentUser();
				if (editDocumentLink && me?.access?.canWriteDocuments) {
					editDocumentLink.href =
						`${base}documents/edit?path=` +
						encodeURIComponent(data.path);
					editDocumentLink.hidden = false;
				}

				if (backToDocuments) {
					const backUrl = new URL(`${base}documents`, window.location.origin);
					const segments = String(data.path || "").split("/");
					if (segments.length === 3) {
						backUrl.searchParams.set("category", segments[1]);
					} else {
						backUrl.searchParams.set("uncategorized", "1");
					}
					backToDocuments.href = `${backUrl.pathname}${backUrl.search}`;
				}

				document.title =
					`${data.name} | SYLU-ICDL`;

				marked.setOptions({
					gfm: true,
					breaks: false,
				});

				const rendered =
					await marked.parse(data.markdown);

				const safeHtml = DOMPurify.sanitize(
					rendered,
					{
						USE_PROFILES: {
							html: true,
						},
					}
				);

				if (content) {
					content.innerHTML = safeHtml;

					for (
						const link of content.querySelectorAll<HTMLAnchorElement>(
							"a"
						)
					) {
						if (
							link.hostname &&
							link.hostname !==
								window.location.hostname
						) {
							link.target = "_blank";
							link.rel =
								"noopener noreferrer";
						}
					}
				}

				createTableOfContents();
				showOnly(layout);
			} catch (error) {
				console.error(error);

				if (errorMessage) {
					errorMessage.textContent =
						"无法连接共享文档服务，请检查网络或 Worker 状态。";
				}

				showOnly(errorBox);
			}
		}

		loadDocument();
	</script>

	<style is:global>
		html {
			scroll-behavior: smooth;
		}

		.reader-page {
			min-height: calc(100vh - 68px);
			padding: 30px 0 70px;
			background:
				linear-gradient(
					180deg,
					#f7f9fc 0,
					#f5f7fb 260px
				);
		}

		.reader-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 20px;
			margin-bottom: 20px;
		}

		.back-link {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: #536078;
			font-size: 14px;
			font-weight: 600;
		}

		.back-link:hover {
			color: #2563eb;
		}

		.reader-topbar-actions {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.reader-source {
			color: #9aa4b2;
			font-size: 12px;
		}

		.edit-document-link {
			display: inline-flex;
			height: 36px;
			align-items: center;
			justify-content: center;
			padding: 0 14px;
			border-radius: 8px;
			background: #2563eb;
			color: #ffffff;
			font-size: 13px;
			font-weight: 700;
		}

		.edit-document-link[hidden] {
			display: none;
		}

		.edit-document-link:hover {
			background: #1f56ce;
		}

		.reader-layout {
			display: grid;
			grid-template-columns:
				minmax(0, 1fr)
				220px;
			align-items: start;
			gap: 26px;
		}

		.reader-layout[hidden],
		.reader-state[hidden] {
			display: none;
		}

		.document-shell {
			min-width: 0;
			overflow: hidden;
			border: 1px solid #e1e6ee;
			border-radius: 16px;
			background: #fff;
			box-shadow:
				0 16px 45px rgba(34, 51, 84, .055);
		}

		.document-header {
			padding: 42px 50px 34px;
			border-bottom: 1px solid #edf0f4;
			background:
				linear-gradient(
					135deg,
					#ffffff 0%,
					#f8fbff 100%
				);
		}

		.document-kicker {
			margin-bottom: 13px;
			color: #2563eb;
			font-size: 13px;
			font-weight: 700;
			letter-spacing: .6px;
		}

		.document-header h1 {
			margin: 0 0 13px;
			color: #162033;
			font-size: clamp(30px, 4vw, 42px);
			line-height: 1.2;
			letter-spacing: -.7px;
		}

		.document-meta {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 7px;
			color: #8a95a6;
			font-size: 13px;
		}

		.meta-divider {
			color: #c2c8d0;
		}

		.markdown-body {
			max-width: 900px;
			margin: 0 auto;
			padding: 44px 50px 70px;
			color: #344054;
			font-size: 16px;
			line-height: 1.85;
			overflow-wrap: anywhere;
		}

		.markdown-body > :first-child {
			margin-top: 0 !important;
		}

		.markdown-body > :last-child {
			margin-bottom: 0 !important;
		}

		.markdown-body h1,
		.markdown-body h2,
		.markdown-body h3,
		.markdown-body h4 {
			color: #172033;
			font-weight: 700;
			line-height: 1.38;
			scroll-margin-top: 90px;
		}

		.markdown-body h1 {
			margin: 0 0 24px;
			padding-bottom: 14px;
			border-bottom: 1px solid #e9edf2;
			font-size: 30px;
		}

		.markdown-body h2 {
			margin: 42px 0 18px;
			padding-bottom: 10px;
			border-bottom: 1px solid #edf0f4;
			font-size: 24px;
		}

		.markdown-body h3 {
			margin: 30px 0 12px;
			font-size: 19px;
		}

		.markdown-body h4 {
			margin: 24px 0 10px;
			font-size: 16px;
		}

		.markdown-body p {
			margin: 0 0 18px;
		}

		.markdown-body strong {
			color: #202b3d;
			font-weight: 700;
		}

		.markdown-body a {
			color: #2563eb;
			text-decoration: none;
			border-bottom: 1px solid
				rgba(37, 99, 235, .25);
		}

		.markdown-body a:hover {
			border-bottom-color: #2563eb;
		}

		.markdown-body ul,
		.markdown-body ol {
			margin: 0 0 20px;
			padding-left: 1.7em;
		}

		.markdown-body li {
			margin: 6px 0;
			padding-left: 3px;
		}

		.markdown-body li > ul,
		.markdown-body li > ol {
			margin: 6px 0;
		}

		.markdown-body blockquote {
			margin: 24px 0;
			padding: 14px 18px;
			border-left: 4px solid #7da6f8;
			border-radius: 0 8px 8px 0;
			background: #f6f9ff;
			color: #59667a;
		}

		.markdown-body blockquote p:last-child {
			margin-bottom: 0;
		}

		.markdown-body code {
			padding: 2px 6px;
			border-radius: 5px;
			background: #f0f3f7;
			color: #c0395a;
			font-family:
				"SFMono-Regular",
				Consolas,
				"Liberation Mono",
				monospace;
			font-size: .9em;
		}

		.markdown-body pre {
			margin: 24px 0;
			padding: 18px 20px;
			overflow-x: auto;
			border: 1px solid #e1e6ed;
			border-radius: 10px;
			background: #f7f9fb;
			line-height: 1.65;
		}

		.markdown-body pre code {
			padding: 0;
			background: transparent;
			color: #263244;
			font-size: 13px;
		}

		.markdown-body table {
			display: block;
			width: 100%;
			margin: 24px 0;
			overflow-x: auto;
			border-collapse: collapse;
			border-spacing: 0;
			font-size: 14px;
		}

		.markdown-body th,
		.markdown-body td {
			min-width: 120px;
			padding: 11px 14px;
			border: 1px solid #dfe5ec;
			text-align: left;
			vertical-align: top;
		}

		.markdown-body th {
			background: #f5f7fa;
			color: #273349;
			font-weight: 700;
		}

		.markdown-body tr:nth-child(even) td {
			background: #fbfcfd;
		}

		.markdown-body hr {
			height: 1px;
			margin: 36px 0;
			border: 0;
			background: #e8ecf1;
		}

		.markdown-body img {
			display: block;
			max-width: 100%;
			height: auto;
			margin: 26px auto;
			border-radius: 8px;
			box-shadow:
				0 6px 20px rgba(34, 51, 84, .08);
		}

		.toc-panel {
			position: sticky;
			top: 92px;
			max-height: calc(100vh - 120px);
			overflow-y: auto;
			padding: 18px 16px;
			border-left: 1px solid #dfe5ec;
		}

		.toc-panel[hidden] {
			display: none;
		}

		.toc-title {
			margin-bottom: 12px;
			color: #273349;
			font-size: 13px;
			font-weight: 700;
		}

		.toc-list {
			display: flex;
			flex-direction: column;
			gap: 3px;
		}

		.toc-link {
			display: block;
			padding: 7px 8px;
			border-radius: 6px;
			color: #718096;
			font-size: 12px;
			line-height: 1.5;
		}

		.toc-link:hover {
			background: #eef4ff;
			color: #2563eb;
		}

		.toc-link-level-3 {
			padding-left: 20px;
			color: #929cac;
		}

		.reader-state {
			display: flex;
			min-height: 420px;
			align-items: center;
			justify-content: center;
			flex-direction: column;
			gap: 10px;
			padding: 30px;
			border: 1px solid #e2e7ee;
			border-radius: 16px;
			background: #fff;
			text-align: center;
			color: #718096;
			box-shadow:
				0 16px 45px rgba(34, 51, 84, .045);
		}

		.reader-state h1 {
			margin: 5px 0 0;
			color: #273349;
			font-size: 22px;
		}

		.reader-state p {
			max-width: 620px;
			line-height: 1.7;
		}

		.state-icon {
			display: flex;
			width: 50px;
			height: 50px;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: #fff0f0;
			color: #c54040;
			font-weight: 800;
		}

		.loading-ring {
			width: 32px;
			height: 32px;
			border: 3px solid #e4eaf2;
			border-top-color: #2563eb;
			border-radius: 50%;
			animation: spin .8s linear infinite;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		@media (max-width: 980px) {
			.reader-layout {
				grid-template-columns: minmax(0, 1fr);
			}

			.toc-panel {
				display: none !important;
			}
		}

		@media (max-width: 700px) {
			.reader-page {
				padding-top: 20px;
			}

			.reader-topbar {
				align-items: flex-start;
				flex-direction: column;
			}

			.document-header {
				padding: 30px 24px 25px;
			}

			.markdown-body {
				padding: 30px 24px 50px;
				font-size: 15px;
			}

			.markdown-body h2 {
				font-size: 21px;
			}
		}

		@media print {
			.site-header,
			.reader-topbar,
			.toc-panel {
				display: none !important;
			}

			.reader-page {
				padding: 0;
				background: #fff;
			}

			.reader-layout {
				display: block;
				width: 100%;
				max-width: none;
			}

			.document-shell {
				border: 0;
				box-shadow: none;
			}
		}
	</style>
</BaseLayout>
