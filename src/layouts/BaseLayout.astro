---
import "../styles/global.css";
import LabChatWidget from "../components/LabChatWidget.astro";

interface Props {
  title?: string;
  protectedPage?: boolean;
  requiredRole?: "member" | "editor" | "admin";
}

const {
  title = "SYLU-ICDL 科研协作平台",
  protectedPage = false,
  requiredRole = "member",
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="沈阳理工大学智能控制与缺陷检测实验室科研协作平台" />
    <title>{title}</title>
  </head>
  <body
    class:list={{ "auth-pending": protectedPage }}
    data-protected={protectedPage ? "true" : "false"}
    data-required-role={requiredRole}
    data-login-url={`${base}login`}
    data-verify-url={`${base}verify`}
    data-home-url={base}
  >
    <header class="site-header">
      <a href={base} class="brand">SYLU-ICDL</a>
      <nav class="nav">
        <a href={base}>首页</a>
        <a href={`${base}documents`}>共享文档</a>
        <a href={`${base}achievements`}>历届成果</a>
        <a href={`${base}workspace`}>科研工作区</a>
        <span id="admin-nav-slot"></span>
        <div id="auth-status" class="auth-status">
          <a href={`${base}login`} class="login-button">登录</a>
        </div>
      </nav>
    </header>
    <div id="page-content"><slot /></div>
    <LabChatWidget />

    <script>
      import { clearSession, getCurrentUser, hasRole, type AuthMe } from "../lib/auth";
      const body = document.body;
      const authStatus = document.querySelector("#auth-status");
      const adminSlot = document.querySelector("#admin-nav-slot");
      const protectedPage = body.dataset.protected === "true";
      const requiredRole = (body.dataset.requiredRole || "member") as "member" | "editor" | "admin";
      const loginUrl = body.dataset.loginUrl || "/login";
      const verifyUrl = body.dataset.verifyUrl || "/verify";
      const homeUrl = body.dataset.homeUrl || "/";

      function currentPath() { return window.location.pathname + window.location.search; }
      function renderLoggedOut() {
        if (adminSlot) adminSlot.replaceChildren();
        if (!authStatus) return;
        const link=document.createElement("a"); link.href=loginUrl; link.className="login-button"; link.textContent="登录";
        authStatus.replaceChildren(link);
      }
      function renderLoggedIn(me:AuthMe) {
        if (adminSlot) {
          adminSlot.replaceChildren();
          if (me.access.isAdmin) {
            const link=document.createElement("a"); link.href=`${homeUrl}admin`; link.className="admin-nav-link"; link.textContent="管理";
            adminSlot.append(link);
          }
        }
        if (!authStatus) return;
        const wrapper=document.createElement("div"); wrapper.className="user-menu";
        const avatar=document.createElement("img"); avatar.className="user-avatar"; avatar.src=me.user.avatarUrl; avatar.alt="GitHub 头像";
        const name=document.createElement("span"); name.className="user-name"; name.textContent=me.access.name || me.user.name || me.user.login;
        const logout=document.createElement("button"); logout.type="button"; logout.className="logout-button"; logout.textContent="退出";
        logout.addEventListener("click",()=>{clearSession();window.location.href=loginUrl;});
        wrapper.append(avatar,name,logout); authStatus.replaceChildren(wrapper);
      }
      async function initializeAuth() {
        const me=await getCurrentUser();
        if (me) {
          renderLoggedIn(me);
          if (protectedPage && !me.access.authorized) {
            window.location.replace(`${verifyUrl}?next=${encodeURIComponent(currentPath())}`); return;
          }
          if (protectedPage && !hasRole(me, requiredRole)) {
            window.location.replace(homeUrl); return;
          }
          body.classList.remove("auth-pending"); return;
        }
        renderLoggedOut();
        if (protectedPage) {
          window.location.replace(`${loginUrl}?next=${encodeURIComponent(currentPath())}`); return;
        }
        body.classList.remove("auth-pending");
      }
      initializeAuth();
    </script>
  </body>
</html>
